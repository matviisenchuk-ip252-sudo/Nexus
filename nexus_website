function gotoStep(n,init=false){
  if(!init&&n===2){
    if(!document.getElementById('dName').value.trim()||!document.getElementById('dPhone').value.trim()||!document.getElementById('dCity').value.trim()){
      showToast('❗ Заповни всі дані доставки','error');return;
    }
  }
  if(!init&&n===3){processPayment();return}
  currentStep=n;
  [1,2,3].forEach(i=>document.getElementById('cstep'+i).classList.toggle('active',i===n));
  [1,2,3].forEach(i=>{
    const dot=document.getElementById('cp'+i);
    if(i<n){dot.className='c-pdot done';dot.textContent='✓'}
    else if(i===n){dot.className='c-pdot active';dot.textContent=i}
    else{dot.className='c-pdot';dot.textContent=i}
  });
  [1,2].forEach(i=>{if(document.getElementById('cl'+i)) document.getElementById('cl'+i).classList.toggle('done',i<n)});
  const titles={1:'📦 ДОСТАВКА',2:'💳 ОПЛАТА',3:'✅ ПІДТВЕРДЖЕННЯ'};
  document.getElementById('checkoutTitle').textContent=titles[n];
}
