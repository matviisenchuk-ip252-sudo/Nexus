  const p = products.find(x => x.id === id);
  if (!p) return;
  document.getElementById('searchIn').value = p.name;
  document.getElementById('searchDropdown').classList.remove('show');
  renderGrid();
  setTimeout(() => openModal(id), 100);
}

/* ===== OVERRIDE renderGrid to add price/rating filter ===== */
const _origRenderGrid = renderGrid;
renderGrid = function() {
  const search = document.getElementById('searchIn').value.toLowerCase();
  let list = products.filter(p => {
    const catMatch = activeCategory === 'all' || p.cat === activeCategory;
    const searchMatch = p.name.toLowerCase().includes(search) || p.cat.toLowerCase().includes(search);
    const priceMatch = p.price >= priceMin && p.price <= priceMax;
    const ratingMatch = ratingFilter === 0 || p.rating >= ratingFilter;
    return catMatch && searchMatch && priceMatch && ratingMatch;
  });
  if (sortMode === 'price_asc') list.sort((a,b) => a.price - b.price);
  else if (sortMode === 'price_desc') list.sort((a,b) => b.price - a.price);
  else if (sortMode === 'rating') list.sort((a,b) => b.rating - a.rating);
  else if (sortMode === 'reviews') list.sort((a,b) => b.reviews - a.reviews);
  const grid = document.getElementById('productsGrid');
  grid.className = 'grid' + (viewMode === 'list' ? ' list-view' : '');
  const countEl = document.getElementById('productCount');
  if (countEl) countEl.textContent = `${list.length} товарів`;
  if (!list.length) {
    grid.innerHTML = `<div class="empty-state"><div>🔍</div><p>Нічого не знайдено за заданими фільтрами</p></div>`;
    return;
  }
  const bmap = {new:'badge-new NEW', hot:'badge-hot HOT', sale:'badge-sale SALE', top:'badge-top TOP'};
  const stars = r => '★'.repeat(Math.floor(r)) + (r%1>=.5?'½':'') + ('☆'.repeat(5-Math.floor(r)-(r%1>=.5?1:0)));
  const inCompare = id => compareList.includes(id);
  grid.innerHTML = list.map((p,i) => {
    const inW = wishlist.includes(p.id);
    const bp = bmap[p.badge]?.split(' ') || [];
    const disc = p.oldPrice ? Math.round((1-p.price/p.oldPrice)*100) : null;
    const stockPct = 55 + ((p.id*37) % 45);
    const stockClass = stockPct > 70 ? 'green' : stockPct > 40 ? 'yellow' : 'red';
    const stockColor = stockPct > 70 ? 'var(--accent2)' : stockPct > 40 ? 'var(--gold)' : 'var(--accent3)';
    return `<div class="card" style="animation-delay:${i*.04}s" onclick="openModal(${p.id})">
      <div class="card-img-wrap">
        <img src="${p.img}" alt="${p.name}" loading="lazy" onerror="this.style.display='none';this.parentElement.querySelector('.img-fallback').style.display='flex'">
        <div class="img-fallback" style="display:none;width:100%;height:190px;align-items:center;justify-content:center;flex-direction:column;background:linear-gradient(135deg,var(--surface2),var(--surface3));gap:8px"><span style="font-size:48px;opacity:.5">${p.imgIcon}</span><span style="font-size:11px;color:var(--text3);padding:0 12px;text-align:center">${p.name}</span></div>
        <div class="card-badges">
          ${bp[0]?`<span class="badge ${bp[0]}">${bp[1]}</span>`:''}
          ${disc?`<span class="badge badge-sale">−${disc}%</span>`:''}
        </div>
        <button class="wishlist-btn${inW?' active':''}" onclick="toggleWish(event,${p.id})" title="В вподобане">♥</button>
        <button class="card-compare-btn${inCompare(p.id)?' active':''}" onclick="toggleCompare(event,${p.id})" title="Порівняти">⚖</button>
        <div class="card-overlay"><button class="quick-add" onclick="addCart(event,${p.id})">🛒 + В кошик</button></div>
      </div>
      <div class="card-body">
        <div class="card-cat">${p.cat}</div>
        <h4>${p.name}</h4>
        <div class="card-rating">
          <span class="stars">${stars(p.rating)}</span>
          <span class="rating-count">(${p.reviews.toLocaleString()})</span>
          <span class="live-viewers">👁 ${3+((p.id*13+7)%21)} зараз</span>
        </div>
        <div style="margin-bottom:8px">
          <div style="display:flex;justify-content:space-between;align-items:center;font-size:10px;color:var(--text3);margin-bottom:4px">
            <span style="display:flex;align-items:center"><span class="in-stock-dot ${stockClass}"></span>В наявності</span>
            <span style="font-weight:700;color:${stockColor}">${stockPct}%</span>
          </div>
          <div style="height:4px;background:var(--surface3);border-radius:4px;overflow:hidden">
            <div style="height:4px;width:${stockPct}%;background:linear-gradient(90deg,${stockColor},${stockColor}aa);border-radius:4px;transition:width .6s cubic-bezier(.16,1,.3,1)"></div>
          </div>
        </div>
        <div class="card-footer">
          <div>
            <div style="display:flex;align-items:baseline;gap:6px"><span class="price">$${p.price}</span>${p.oldPrice?`<span class="price-old">$${p.oldPrice}</span>`:''}</div>
            <div style="font-size:10px;color:var(--text3);margin-top:1px">≈ ${toUAH(p.price)} ₴</div>
          </div>
          <button class="add-btn" onclick="addCart(event,${p.id})" title="В кошик">+</button>
        </div>
      </div>
    </div>`;
  }).join('');
};

/* ===== PROFILE ===== */
let profileData = {};
let orderHistory = [];

function openProfile() {
  profileData = JSON.parse(localStorage.getItem('nx_profile_' + currentUser) || '{}');
  orderHistory = JSON.parse(localStorage.getItem('nx_orders_' + currentUser) || '[]');

  // Fill avatar
  const avatarImg = document.getElementById('profileAvatarImg');
  const avatarPh  = document.getElementById('profileAvatarPlaceholder');
  const saved = localStorage.getItem('nx_avatar_' + currentUser);
  if (saved) {
    avatarImg.src = saved;
    avatarImg.style.display = 'block';
    avatarPh.style.display = 'none';
    // also update header mini avatar
  } else {
    avatarImg.style.display = 'none';
    avatarPh.style.display = 'flex';
    avatarPh.textContent = currentUser.substring(0,2).toUpperCase();
  }

  // Names & email
  document.getElementById('profileNameDisplay').textContent = (profileData.firstname && profileData.lastname)
    ? profileData.firstname + ' ' + profileData.lastname
    : currentUser;
  document.getElementById('profileEmailDisplay').textContent = profileData.email || (currentUser + '@nexusshop.ua');

  // Fill edit fields
  document.getElementById('pf-firstname').value = profileData.firstname || '';
  document.getElementById('pf-lastname').value  = profileData.lastname  || '';
  document.getElementById('pf-email').value      = profileData.email    || '';
  document.getElementById('pf-phone').value      = profileData.phone    || '';
  document.getElementById('pf-city').value       = profileData.city     || '';
  document.getElementById('pf-zip').value        = profileData.zip      || '';
  document.getElementById('pf-address').value    = profileData.address  || '';

  // Stats
  const spent = orderHistory.reduce((s, o) => s + o.total, 0);
  document.getElementById('ps-orders').textContent = orderHistory.length;
  document.getElementById('ps-spent').textContent  = '$' + spent.toLocaleString();
  document.getElementById('ps-wish').textContent   = wishlist.length;
  document.getElementById('ps-reviews').textContent = Math.floor(orderHistory.length * 0.7);

  // render orders & wishlist tabs
  renderProfileOrders();
  renderProfileWishlist();

  switchProfileTab('overview');
  document.getElementById('profileWrap').classList.add('active');
}

function closeProfile() {
  document.getElementById('profileWrap').classList.remove('active');
}

function switchProfileTab(name) {
  document.querySelectorAll('.profile-section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.profile-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('ptab-' + name).classList.add('active');
  const tabs = ['overview','orders','wishlist','edit','security'];
  const idx = tabs.indexOf(name);
  document.querySelectorAll('.profile-tab')[idx].classList.add('active');
}

function handleAvatarUpload(e) {
  const file = e.target.files[0];
  if (!file) return;
  if (file.size > 5 * 1024 * 1024) { toast('Файл надто великий (макс 5MB)', 'error'); return; }
  const reader = new FileReader();
  reader.onload = function(ev) {
    const dataUrl = ev.target.result;
    localStorage.setItem('nx_avatar_' + currentUser, dataUrl);
    const avatarImg = document.getElementById('profileAvatarImg');
    const avatarPh  = document.getElementById('profileAvatarPlaceholder');
    avatarImg.src = dataUrl;
    avatarImg.style.display = 'block';
    avatarPh.style.display  = 'none';
    // update header avatar too
    const hdr = document.getElementById('userInitials');
    hdr.innerHTML = `<img src="${dataUrl}" style="width:100%;height:100%;border-radius:50%;object-fit:cover">`;
    toast('Аватарка оновлена! 🎉', 'success');
  };
  reader.readAsDataURL(file);
}

function saveProfileData() {
  profileData = {
    firstname: document.getElementById('pf-firstname').value.trim(),
    lastname:  document.getElementById('pf-lastname').value.trim(),
    email:     document.getElementById('pf-email').value.trim(),
    phone:     document.getElementById('pf-phone').value.trim(),
    city:      document.getElementById('pf-city').value.trim(),
    zip:       document.getElementById('pf-zip').value.trim(),
    address:   document.getElementById('pf-address').value.trim(),
  };
  localStorage.setItem('nx_profile_' + currentUser, JSON.stringify(profileData));
  if (profileData.firstname) {
    document.getElementById('profileNameDisplay').textContent =
      profileData.firstname + (profileData.lastname ? ' ' + profileData.lastname : '');
  }
  if (profileData.email) document.getElementById('profileEmailDisplay').textContent = profileData.email;
  toast('Дані збережено ✓', 'success');
}

function renderProfileOrders() {
  const c = document.getElementById('ordersContainer');
  if (!orderHistory.length) {
    c.innerHTML = `<div class="orders-empty"><div>📦</div><p>У тебе ще немає замовлень.<br>Час зробити першу покупку!</p></div>`;
    return;
  }
  c.innerHTML = orderHistory.slice().reverse().map((o, i) => {
    const statusMap = { delivered:'delivered', processing:'processing', cancelled:'cancelled' };
    const statusLabel = { delivered:'Доставлено', processing:'Обробляється', cancelled:'Скасовано' };
    const st = o.status || 'delivered';
    const itemsHTML = (o.items || []).map(it => {
      const p = products.find(x => x.id === it.id) || {};
      return `<div class="order-item-row">
        <img class="order-item-img" src="${p.img || ''}" alt="${p.name || it.name}">
        <div class="order-item-name">${p.name || it.name} × ${it.qty}</div>
        <div class="order-item-price">$${(it.price * it.qty)}</div>
      </div>`;
    }).join('');
    return `<div class="order-card">
      <div class="order-head" onclick="toggleOrderBody(this)" id="ohd-${i}">
        <div>
          <div class="order-num">#${o.num}</div>
          <div style="font-size:10px;color:var(--text3);margin-top:2px">${(o.items||[]).length} товар(ів)</div>
        </div>
        <div class="order-date">${o.date}</div>
        <div class="order-total">$${o.total}</div>
        <span class="order-status ${statusMap[st]}">${statusLabel[st]}</span>
        <span class="order-arrow">▾</span>
      </div>
      <div class="order-body" id="ob-${i}">
        ${itemsHTML}
        <div style="display:flex;justify-content:space-between;align-items:center;padding-top:10px;border-top:1px solid var(--border);margin-top:6px">
          <span style="font-size:11px;color:var(--text3)">Адреса: ${o.address || 'не вказана'}</span>
          <span style="font-family:'Rajdhani',monospace;font-size:15px;font-weight:700;color:var(--accent2)">Разом: $${o.total}</span>
        </div>
      </div>
    </div>`;
  }).join('');
}

function toggleOrderBody(el) {
  el.classList.toggle('open');
  const idx = el.id.replace('ohd-','');
  const body = document.getElementById('ob-' + idx);
  body.classList.toggle('open');
}

function renderProfileWishlist() {
  const c = document.getElementById('profileWishContainer');
  const items = wishlist.map(id => products.find(p => p.id === id)).filter(Boolean);
  if (!items.length) {
    c.innerHTML = `<div class="orders-empty"><div>❤️</div><p>Список вподобаних порожній.<br>Додай товари що сподобались!</p></div>`;
    return;
  }
  c.innerHTML = `<div class="p-wish-grid">${items.map(p => `
    <div class="p-wish-card" onclick="closeProfile();setTimeout(()=>openModal(${p.id}),200)">
      <img class="p-wish-img" src="${p.img}" alt="${p.name}">
      <div class="p-wish-name">${p.name}</div>
      <div class="p-wish-price">$${p.price}</div>
    </div>`).join('')}</div>`;
}

/* ===== PATCH: save orders on checkout success ===== */
const _origFinishOrder = typeof finishOrder === 'function' ? finishOrder : null;
function saveOrderToHistory(cartItems, total) {
  const num = 'NX' + Date.now().toString().slice(-6);
  const order = {
    num,
    date: new Date().toLocaleDateString('uk-UA'),
    total,
    status: 'processing',
    items: cartItems.map(i => ({id: i.id, name: i.name, price: i.price, qty: i.qty})),
    address: (function(){
      try{ return localStorage.getItem('nx_last_addr_'+currentUser)||'Не вказана'; }catch(e){return '';}
    })()
  };
  orderHistory.push(order);
  localStorage.setItem('nx_orders_' + currentUser, JSON.stringify(orderHistory));
}


document.addEventListener('keydown', e => {
  if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
    e.preventDefault();
    document.getElementById('searchIn')?.focus();
  }
});

