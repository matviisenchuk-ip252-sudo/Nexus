.cat-showcase{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;padding:0 28px 20px}
.cat-card{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:16px;text-align:center;cursor:pointer;transition:all .3s;position:relative;overflow:hidden}
.cat-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,var(--cc1,rgba(124,92,252,.1)),var(--cc2,rgba(0,229,195,.05)));opacity:0;transition:opacity .3s}
.cat-card:hover{transform:translateY(-4px);border-color:rgba(124,92,252,.3)}
.cat-card:hover::before{opacity:1}
.cat-card-icon{font-size:32px;margin-bottom:8px}
.cat-card-name{font-size:12px;font-weight:700;letter-spacing:.5px;color:var(--text)}
.cat-card-count{font-size:10px;color:var(--text3);margin-top:2px}

/* ===== PROMO CARDS ROW ===== */
.promo-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding:0 28px 20px}
.promo-card{padding:18px;border-radius:14px;cursor:pointer;transition:transform .3s;border:1px solid transparent}
.promo-card:hover{transform:translateY(-3px)}
.promo-card-1{background:linear-gradient(135deg,rgba(124,92,252,.2),rgba(90,61,224,.1));border-color:rgba(124,92,252,.25)}
.promo-card-2{background:linear-gradient(135deg,rgba(0,229,195,.15),rgba(0,180,155,.08));border-color:rgba(0,229,195,.2)}
.promo-card-3{background:linear-gradient(135deg,rgba(240,165,0,.15),rgba(255,140,0,.08));border-color:rgba(240,165,0,.2)}
.promo-card-icon{font-size:28px;margin-bottom:8px}
.promo-card-title{font-size:13px;font-weight:700;color:var(--text);margin-bottom:3px}
.promo-card-sub{font-size:11px;color:var(--text2);line-height:1.5}

/* ===== TRENDING SECTION ===== */
.section-head{display:flex;align-items:center;justify-content:space-between;padding:0 28px 14px}
.section-title{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:15px;font-weight:700;color:var(--text);letter-spacing:1px}
.section-sub{font-size:11px;color:var(--text3)}
.section-more{font-size:12px;color:var(--accent);cursor:pointer;background:none;border:none;font-family:'Outfit',sans-serif;transition:color .2s}
.section-more:hover{color:var(--accent2)}

/* ===== FEATURED BANNER ===== */
.featured-banner{margin:0 28px 20px;border-radius:18px;overflow:hidden;position:relative;min-height:140px;background:linear-gradient(135deg,#0f0320,#1a0850,#0a1a40);border:1px solid rgba(124,92,252,.2);cursor:pointer;transition:transform .3s}
.featured-banner:hover{transform:scale(1.01)}
.featured-banner-content{position:relative;z-index:2;padding:24px 28px;display:flex;align-items:center;gap:24px}
.featured-banner-text h3{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:20px;font-weight:700;color:#fff;margin-bottom:6px}
.featured-banner-text p{font-size:13px;color:rgba(255,255,255,.6);margin-bottom:14px}
.featured-banner-btn{padding:9px 20px;background:white;color:#7c5cfc;border:none;border-radius:9px;font-size:12px;font-weight:700;cursor:pointer;transition:all .2s;font-family:'Outfit',sans-serif;letter-spacing:.3px}
.featured-banner-btn:hover{background:#7c5cfc;color:#fff}
.featured-banner-price{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:28px;font-weight:700;color:var(--accent2);margin-left:auto;white-space:nowrap}
.featured-banner-glow{position:absolute;top:-40%;right:-10%;width:300px;height:300px;background:radial-gradient(ellipse,rgba(124,92,252,.3),transparent 70%);pointer-events:none}

/* ===== AI BADGE on cards ===== */
.ai-reco-badge{position:absolute;bottom:12px;right:12px;padding:3px 9px;background:linear-gradient(135deg,rgba(124,92,252,.9),rgba(0,229,195,.8));border-radius:8px;font-size:9px;font-weight:700;color:#fff;letter-spacing:.5px;z-index:3;opacity:0;transition:opacity .3s;pointer-events:none}
.card:hover .ai-reco-badge{opacity:1}

/* ===== LIGHT THEME OVERRIDE ===== */
body.light{--bg:#f5f5fa;--surface:#ffffff;--surface2:#f0f0f7;--surface3:#e8e8f0;--border:rgba(0,0,0,.08);--border-h:rgba(0,0,0,.15);--text:#1a1a2e;--text2:#555;--text3:#999;--glow:rgba(124,92,252,.1)}
