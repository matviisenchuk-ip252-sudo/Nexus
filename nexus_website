body.light .search-wrap input{color:#1a1a2e}
body.light .sort-select{color:#1a1a2e;background:#f0f0f7}
body.light .auth-bg{background:radial-gradient(ellipse at 30% 20%,rgba(124,92,252,.08) 0%,transparent 50%),radial-gradient(ellipse at 70% 80%,rgba(0,229,195,.05) 0%,transparent 50%),#f5f5fa}

/* ===== V5 UPGRADES ===== */

