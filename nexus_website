/* ========== CART ========== */
function addCart(e,id){
  e.stopPropagation();
  const p=products.find(x=>x.id===id);if(!p) return;
  const ex=cart.find(x=>x.id===id);
  if(ex) ex.qty++;else cart.push({...p,qty:1});
  saveData();updateCartUI();
  showToast(`✅ ${p.name} в кошику`,'success');
  const b=document.getElementById('cartCount');
  b.classList.remove('bump');void b.offsetWidth;b.classList.add('bump');
}
function removeFromCart(id){cart=cart.filter(x=>x.id!==id);saveData();updateCartUI();updateCartPanel()}
function changeQty(id,d){
  const item=cart.find(x=>x.id===id);if(!item) return;
  item.qty+=d;if(item.qty<=0) cart=cart.filter(x=>x.id!==id);
  saveData();updateCartUI();updateCartPanel();
}
function saveData(){
  if(currentUser){
    localStorage.setItem('nx_cart_'+currentUser,JSON.stringify(cart));
    localStorage.setItem('nx_wish_'+currentUser,JSON.stringify(wishlist));
    localStorage.setItem('nx_recent_'+currentUser,JSON.stringify(recentlyViewed));
  }
}
function getCartTotal(){
  const sub=cart.reduce((s,x)=>s+x.price*x.qty,0);
  const ship=sub>200?0:15;
  const disc=promoApplied?Math.round(sub*promoDiscount):0;
  return {sub,ship,disc,total:sub+ship-disc};
}
function updateCartUI(){
  const n=cart.reduce((s,x)=>s+x.qty,0);
  document.getElementById('cartCount').textContent=n;
  document.getElementById('ddCartCount').textContent=n;
}
function updateCartPanel(){
  const body=document.getElementById('cartBody');
  const summary=document.getElementById('cartSummary');
  const btn=document.getElementById('checkoutBtn');
  if(!cart.length){
    body.innerHTML=`<div class="panel-empty"><div>🛒</div><p>Твій кошик порожній</p></div>`;
    summary.innerHTML='';btn.disabled=true;return;
  }
  btn.disabled=false;
  body.innerHTML=cart.map(item=>`
    <div class="cart-item">
      <img class="cart-item-img" src="${item.img}" alt="${item.name}">
      <div class="cart-item-info">
        <div class="cart-item-name">${item.name}</div>
        <div class="cart-item-cat">${item.cat}</div>
      </div>
      <div class="cart-item-right">
        <span class="cart-item-price">$${item.price*item.qty}</span>
        <div class="qty-wrap">
          <button class="qty-btn" onclick="changeQty(${item.id},-1)">−</button>
          <span class="qty-num">${item.qty}</span>
          <button class="qty-btn" onclick="changeQty(${item.id},1)">+</button>
          <button class="remove-item" onclick="removeFromCart(${item.id})">✕</button>
        </div>
      </div>
    </div>`).join('');
  const {sub,ship,disc,total}=getCartTotal();
  summary.innerHTML=`
    <div class="cart-row"><span>Товари (${cart.reduce((s,x)=>s+x.qty,0)} шт.)</span><span>$${sub}</span></div>
    <div class="cart-row"><span>Доставка</span><span>${ship===0?'🎁 Безкоштовно':'$'+ship}</span></div>
    ${disc?`<div class="cart-row" style="color:var(--accent2)"><span>🎁 Промокод −${Math.round(promoDiscount*100)}%</span><span>−$${disc}</span></div>`:''}
    <div class="cart-row total"><span>Разом</span><span>$${total}</span></div>`;
}
