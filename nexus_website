/* ===== FLASH SALE CARD ===== */
.flash-sale-card{background:linear-gradient(135deg,rgba(255,85,85,.12),rgba(240,165,0,.08));border:1px solid rgba(255,85,85,.25);border-radius:18px;padding:16px;margin:0 28px 20px;display:flex;align-items:center;gap:16px;animation:fadeUp .4s ease}
.flash-icon{font-size:32px;animation:bounce 1s infinite}
