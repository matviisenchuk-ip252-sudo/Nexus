    </div>`;
  setTimeout(()=>{
    const orderId='NX-'+Math.random().toString(36).substring(2,8).toUpperCase();
    const method=payMethods.find(m=>m.id===selPayMethod);
    const {total}=getCartTotal();
    const cartItems = cart.map(i=>({...i})); // snapshot before clearing
    const name=document.getElementById('dName').value.trim();
    document.getElementById('cp3').className='c-pdot done';document.getElementById('cp3').textContent='✓';
    document.getElementById('checkoutTitle').textContent='✅ ОПЛАТА УСПІШНА';
    document.getElementById('payResult').innerHTML=`
      <div class="pay-success">
        <div class="success-icon">✅</div>
        <h3>Дякуємо, ${name.split(' ')[0] || currentUser}!</h3>
        <p>Ваше замовлення прийнято та передане до обробки.<br>Очікуйте SMS-підтвердження на вказаний номер.</p>
        <div class="order-num">${orderId}</div>
