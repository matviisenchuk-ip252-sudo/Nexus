.trending-mini-img{width:100%;height:110px;object-fit:cover;background:var(--surface2)}
.trending-mini-body{padding:10px}
.trending-mini-name{font-size:12px;font-weight:600;margin-bottom:3px;line-height:1.3}
.trending-mini-price{font-family:'Rajdhani',monospace;font-size:15px;font-weight:700;color:var(--accent2)}
.trending-rank{position:absolute;top:8px;left:8px;width:24px;height:24px;background:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;color:#fff;font-family:'Outfit',sans-serif}

/* ===== SEARCH SUGGESTIONS ===== */
.search-dropdown{position:absolute;top:calc(100% + 6px);left:0;right:0;background:var(--surface);border:1px solid rgba(124,92,252,.2);border-radius:12px;box-shadow:0 12px 40px rgba(0,0,0,.5);z-index:200;overflow:hidden;max-height:280px;overflow-y:auto;display:none}
.search-dropdown.show{display:block;animation:fadeUp .2s ease}
.search-suggestion{display:flex;align-items:center;gap:10px;padding:10px 14px;cursor:pointer;transition:background .15s;font-size:13px}
.search-suggestion:hover{background:var(--surface2)}
.search-suggestion-icon{font-size:18px;flex-shrink:0}
.search-suggestion-name{flex:1;font-weight:500}
.search-suggestion-price{font-family:'Rajdhani',monospace;font-size:13px;font-weight:700;color:var(--accent2);flex-shrink:0}
.search-suggestion-cat{font-size:10px;color:var(--text3);font-weight:600;letter-spacing:.5px}

/* ===== COUNTDOWN ENHANCED ===== */
.promo-countdown span{font-family:'JetBrains Mono','Rajdhani',monospace;letter-spacing:2px;color:var(--accent2);text-shadow:0 0 12px rgba(0,229,195,.5)}

/* ===== FOOTER V5 ===== */
.footer-logo{font-family:'Rajdhani',monospace;font-size:26px;letter-spacing:4px}

/* ===== SMOOTH SCROLL ===== */
html{scroll-behavior:smooth}

/* ===== GRID IMPROVEMENTS ===== */
.grid{gap:20px}

/* ===== PRICE RANGE SLIDER LOOK ===== */
input[type=range]{-webkit-appearance:none;width:100%;height:3px;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:2px;outline:none;cursor:pointer}
