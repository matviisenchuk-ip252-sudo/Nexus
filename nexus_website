/* ===== PRICE RANGE FILTER ===== */
.price-filter{display:flex;align-items:center;gap:10px;padding:0 28px 14px;flex-wrap:wrap}
.price-filter label{font-size:11px;color:var(--text3);letter-spacing:1px;text-transform:uppercase;font-weight:700}
.price-inputs{display:flex;align-items:center;gap:6px}
.price-input{width:80px;padding:6px 10px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:12px;font-family:'Outfit',sans-serif;outline:none;text-align:center}
.price-input:focus{border-color:var(--accent)}
.price-sep{color:var(--text3);font-size:12px}
.price-apply-btn{padding:6px 14px;background:var(--accent);border:none;border-radius:8px;color:#fff;font-size:11px;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif;transition:all .2s}
.price-apply-btn:hover{background:#6a4ce8;transform:scale(1.04)}
.price-reset-btn{padding:6px 10px;background:var(--surface2);border:1px solid var(--border);border-radius:8px;color:var(--text3);font-size:11px;font-weight:700;cursor:pointer;font-family:'Outfit',sans-serif;transition:all .2s}
.price-reset-btn:hover{border-color:var(--accent3);color:var(--accent3)}
.active-filters{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.active-filter-chip{display:flex;align-items:center;gap:4px;padding:4px 10px;background:rgba(124,92,252,.15);border:1px solid rgba(124,92,252,.3);border-radius:20px;font-size:10px;font-weight:700;color:var(--accent);letter-spacing:.5px}
.active-filter-chip button{background:none;border:none;color:var(--accent3);cursor:pointer;font-size:12px;padding:0;margin-left:2px;line-height:1}

/* ===== STOCK BADGE ===== */
.stock-low{color:var(--accent3)!important;font-weight:700}

/* ===== ENHANCED CARD V5 ===== */
.card{border-radius:20px}
.card::before{content:'';position:absolute;inset:0;border-radius:20px;background:linear-gradient(135deg,rgba(124,92,252,.06),transparent);opacity:0;transition:opacity .3s;pointer-events:none;z-index:0}
.card:hover::before{opacity:1}
.card-img-wrap{border-radius:20px 20px 0 0}

/* ===== RATING FILTER BAR ===== */
.rating-filter{display:flex;gap:5px;align-items:center;margin-left:8px}
.rating-filter-btn{padding:5px 10px;background:var(--surface2);border:1px solid var(--border);border-radius:20px;color:var(--text3);font-size:11px;font-weight:700;cursor:pointer;transition:all .2s;white-space:nowrap}
.rating-filter-btn.active{background:rgba(240,165,0,.15);border-color:var(--gold);color:var(--gold)}
.rating-filter-btn:hover{border-color:var(--gold);color:var(--gold)}

/* ===== NEW TAG BADGE ===== */
.v5-tag{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;background:linear-gradient(135deg,var(--accent),var(--accent2));border-radius:20px;font-size:9px;font-weight:800;color:#000;letter-spacing:1px;margin-left:6px;vertical-align:middle}

/* ===== LOADING SKELETON ===== */
.skeleton-card{background:var(--surface);border:1px solid var(--border);border-radius:20px;overflow:hidden;animation:skeletonFade 1.5s ease infinite}
@keyframes skeletonFade{0%,100%{opacity:.5}50%{opacity:1}}
.skeleton-img{width:100%;height:190px;background:linear-gradient(90deg,var(--surface2) 25%,var(--surface3) 50%,var(--surface2) 75%);background-size:200% 100%;animation:shimmer 1.5s infinite}
@keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
.skeleton-line{height:12px;border-radius:6px;background:linear-gradient(90deg,var(--surface2) 25%,var(--surface3) 50%,var(--surface2) 75%);background-size:200% 100%;animation:shimmer 1.5s infinite;margin:8px 16px}
.skeleton-line.short{width:60%;margin:4px 16px}
.skeleton-line.price{width:40%;height:20px;margin:12px 16px}

/* ===== QUICK VIEW TOOLTIP ===== */
.card-quick-view{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(.8);opacity:0;background:rgba(124,92,252,.95);color:#fff;border:none;border-radius:10px;padding:8px 14px;font-size:11px;font-weight:700;font-family:'Outfit',sans-serif;cursor:pointer;transition:all .25s;z-index:4;white-space:nowrap;letter-spacing:.5px}
.card:hover .card-quick-view{opacity:1;transform:translate(-50%,-50%) scale(1)}

/* ===== IN STOCK INDICATOR ===== */
.in-stock-dot{display:inline-block;width:6px;height:6px;border-radius:50%;margin-right:4px;flex-shrink:0}
.in-stock-dot.green{background:var(--accent2);box-shadow:0 0 6px var(--accent2)}
.in-stock-dot.yellow{background:var(--gold);box-shadow:0 0 6px var(--gold)}
.in-stock-dot.red{background:var(--accent3);box-shadow:0 0 6px var(--accent3)}

/* ===== HEADER V5 UPGRADE ===== */
header{background:rgba(6,6,8,.95);border-bottom:1px solid rgba(124,92,252,.12)}
.logo{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:20px;letter-spacing:4px;font-weight:700}
.logo-dot{animation:pulse 1.5s infinite}

/* ===== NOTIFICATION DOT ===== */
.has-notif{position:relative}
.notif-ring{position:absolute;top:-2px;right:-2px;width:8px;height:8px;background:var(--accent3);border-radius:50%;border:2px solid var(--bg);animation:pulse 1.5s infinite}

/* ===== PRODUCT COUNT BADGE ===== */
.count-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;background:var(--surface2);border:1px solid var(--border);border-radius:20px;font-size:11px;color:var(--text2);font-weight:600}

/* ===== ENHANCED MODAL V5 ===== */
.modal-tabs{display:flex;gap:2px;margin-bottom:16px;background:var(--surface2);border-radius:10px;padding:3px}
.modal-tab{flex:1;padding:8px;border:none;background:transparent;color:var(--text3);font-size:12px;font-weight:700;font-family:'Outfit',sans-serif;cursor:pointer;border-radius:8px;transition:all .2s;letter-spacing:.3px}
.modal-tab.active{background:var(--accent);color:#fff}
.modal-tab-content{display:none}
.modal-tab-content.active{display:block;animation:fadeUp .25s ease}

/* ===== AI BADGE GLOW ===== */
#aiChatBtn{background:linear-gradient(135deg,#7c5cfc,#00e5c3);box-shadow:0 4px 24px rgba(124,92,252,.5);animation:float 3s ease-in-out infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}

/* ===== NEW SECTION: TRENDING ===== */
.trending-section{padding:0 28px 24px}
.trending-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;margin-top:14px}
.trending-mini-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;cursor:pointer;transition:all .25s;display:flex;flex-direction:column}
