.stats-bar{background:linear-gradient(90deg,rgba(124,92,252,.06),rgba(0,229,195,.04));border-bottom:1px solid var(--border)}
.stat-item{gap:10px}

/* ===== CARD HOVER PRICE PULSE ===== */
.card:hover .price{color:var(--accent2);transition:color .3s}

/* ===== GRID LIST VIEW IMPROVEMENTS ===== */
.grid.list-view .card{flex-direction:row;max-height:130px}
