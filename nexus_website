<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NexusSHOP v5 — Next-Gen Tech Store 🚀</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#060608;--surface:#0e0e12;--surface2:#16161c;--surface3:#1e1e26;
  --border:rgba(255,255,255,.06);--border-h:rgba(255,255,255,.14);
  --accent:#7c5cfc;--accent2:#00e5c3;--accent3:#ff5555;
  --text:#f0f0f8;--text2:#888;--text3:#555;
  --glow:rgba(124,92,252,.18);--glow2:rgba(0,229,195,.12);
  --green:#22c55e;--gold:#f0a500;
}
body{font-family:'Outfit',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden}
body::before{content:'';position:fixed;top:-20%;left:-10%;width:60%;height:60%;background:radial-gradient(ellipse,rgba(124,92,252,.08) 0%,transparent 70%);pointer-events:none;z-index:0}
body::after{content:'';position:fixed;bottom:-20%;right:-10%;width:50%;height:50%;background:radial-gradient(ellipse,rgba(0,229,195,.06) 0%,transparent 70%);pointer-events:none;z-index:0}
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:var(--surface)}
::-webkit-scrollbar-thumb{background:var(--accent);border-radius:4px}

/* ===== BRANDS STRIP ===== */
.brands-strip{background:var(--surface);border-top:1px solid var(--border);padding:14px 0;overflow:hidden}
.brands-inner{display:flex;align-items:center;gap:24px;padding:0 28px}
.brands-label{font-size:10px;font-weight:700;color:var(--text3);letter-spacing:2px;text-transform:uppercase;white-space:nowrap;flex-shrink:0}
.brands-scroll{display:flex;gap:16px;overflow:hidden;mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);animation:brandScroll 22s linear infinite}
@keyframes brandScroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.brand-tag{font-size:12px;font-weight:700;color:var(--text2);padding:5px 14px;border:1px solid var(--border);border-radius:20px;white-space:nowrap;letter-spacing:.5px;transition:all .2s}
.brand-tag:hover{border-color:var(--border-h);color:var(--text)}

/* ===== FOOTER ===== */
.site-footer{background:var(--surface);border-top:1px solid var(--border);padding:40px 0 0}
.footer-inner{display:flex;gap:48px;padding:0 28px 32px;border-bottom:1px solid var(--border)}
.footer-brand{flex:1.5}
.footer-logo{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:22px;font-weight:700;color:var(--accent);letter-spacing:3px;margin-bottom:10px}
.footer-logo span{color:var(--text)}
.footer-tagline{font-size:13px;color:var(--text3);margin-bottom:18px;line-height:1.6}
.footer-socials{display:flex;gap:8px;flex-wrap:wrap}
.social-pill{padding:7px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:20px;color:var(--text2);font-size:12px;font-weight:600;text-decoration:none;transition:all .2s}
.social-pill:hover{border-color:var(--accent);color:var(--accent)}
.footer-links{display:flex;gap:40px;flex:2}
.footer-col{display:flex;flex-direction:column;gap:10px}
.footer-col strong{font-size:12px;font-weight:700;color:var(--text);letter-spacing:.5px;text-transform:uppercase;margin-bottom:4px}
.footer-col a{font-size:13px;color:var(--text3);text-decoration:none;transition:color .2s}
.footer-col a:hover{color:var(--accent)}
.footer-bottom{display:flex;align-items:center;justify-content:space-between;padding:16px 28px;font-size:12px;color:var(--text3)}
.footer-badges{display:flex;gap:10px}
.f-badge{padding:4px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:20px;font-size:11px;font-weight:600;color:var(--text2)}

/* ===== AUTH ===== */
.auth-wrap{display:flex;justify-content:center;align-items:center;min-height:100vh;position:relative;z-index:10}
.auth-bg{position:fixed;inset:0;background:radial-gradient(ellipse at 30% 20%,rgba(124,92,252,.12) 0%,transparent 50%),radial-gradient(ellipse at 70% 80%,rgba(0,229,195,.08) 0%,transparent 50%),#060608}
.auth-box{position:relative;width:400px;background:var(--surface);border:1px solid rgba(124,92,252,.2);border-radius:24px;padding:44px 40px;box-shadow:0 0 80px rgba(124,92,252,.12),0 0 0 1px rgba(124,92,252,.08);animation:slideUp .5s cubic-bezier(.16,1,.3,1)}
.auth-logo{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:24px;font-weight:700;color:var(--accent);letter-spacing:3px;margin-bottom:4px;text-align:center}
.auth-logo span{color:var(--text)}
.auth-sub{text-align:center;color:var(--text3);font-size:11px;margin-bottom:30px;letter-spacing:2px;text-transform:uppercase}
.form-group{position:relative;margin-bottom:14px}
.form-group label{display:block;font-size:11px;font-weight:600;color:var(--text2);letter-spacing:1px;text-transform:uppercase;margin-bottom:6px}
.field{width:100%;padding:13px 16px;background:var(--surface2);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:14px;font-family:'Outfit',sans-serif;outline:none;transition:border .2s,box-shadow .2s}
.field:focus{border-color:rgba(124,92,252,.5);box-shadow:0 0 0 3px rgba(124,92,252,.1)}
.btn{width:100%;padding:13px;border:none;border-radius:10px;cursor:pointer;font-size:14px;font-weight:600;font-family:'Outfit',sans-serif;margin-top:8px;transition:all .2s;letter-spacing:.3px}
.btn:active{transform:scale(.98)}
.btn-primary{background:linear-gradient(135deg,#7c5cfc,#5a3de0);color:#fff;box-shadow:0 4px 20px rgba(124,92,252,.35)}
.btn-primary:hover{box-shadow:0 6px 30px rgba(124,92,252,.5);transform:translateY(-1px)}
.btn-ghost{background:transparent;color:var(--text2);border:1px solid var(--border);margin-top:6px}
.btn-ghost:hover{border-color:var(--border-h);color:var(--text)}
.auth-msg{font-size:12px;text-align:center;margin-top:12px;min-height:16px;color:var(--accent3)}
.auth-msg.ok{color:var(--accent2)}
.auth-divider{display:flex;align-items:center;gap:12px;margin:16px 0}
.auth-divider::before,.auth-divider::after{content:'';flex:1;height:1px;background:var(--border)}
.auth-divider span{font-size:11px;color:var(--text3);letter-spacing:.5px}
.auth-demo{margin-top:14px;padding:12px;background:rgba(124,92,252,.08);border:1px dashed rgba(124,92,252,.2);border-radius:8px;font-size:11px;color:var(--text3);text-align:center;line-height:1.8}
.auth-demo b{color:var(--accent)}

/* ===== HEADER ===== */
header{display:flex;align-items:center;justify-content:space-between;padding:0 28px;height:64px;background:rgba(6,6,8,.9);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:100}
.logo{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:17px;font-weight:700;color:var(--accent);letter-spacing:3px;display:flex;align-items:center;gap:8px;cursor:default}
.logo span{color:var(--text)}
.logo-dot{width:7px;height:7px;background:var(--accent2);border-radius:50%;animation:pulse 2s infinite;box-shadow:0 0 8px var(--accent2)}
.header-center{display:flex;align-items:center;gap:8px;flex:1;max-width:420px;margin:0 28px}
.search-wrap{position:relative;flex:1}
.search-wrap input{width:100%;padding:10px 14px 10px 38px;background:var(--surface2);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:13px;font-family:'Outfit',sans-serif;outline:none;transition:border .2s,box-shadow .2s}
.search-wrap input:focus{border-color:rgba(124,92,252,.4);box-shadow:0 0 0 3px rgba(124,92,252,.08)}
.search-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text3);font-size:15px}
.header-right{display:flex;align-items:center;gap:8px}
.icon-btn{display:flex;align-items:center;gap:6px;padding:8px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:9px;color:var(--text2);cursor:pointer;font-size:13px;transition:all .2s;white-space:nowrap}
.icon-btn:hover{border-color:var(--border-h);color:var(--text);background:var(--surface3)}
.cart-badge,.wish-badge{font-size:10px;font-weight:700;padding:2px 7px;border-radius:10px;min-width:20px;text-align:center}
.cart-badge{background:var(--accent);color:#fff}
.wish-badge{background:var(--accent3);color:#fff}
.cart-badge.bump{animation:bump .3s cubic-bezier(.36,.07,.19,.97)}

/* ===== FILTER BAR ===== */
.filter-bar{display:flex;align-items:center;gap:8px;padding:14px 28px;border-bottom:1px solid var(--border);overflow-x:auto;background:rgba(14,14,18,.7);backdrop-filter:blur(10px)}
.filter-bar::-webkit-scrollbar{height:0}
.cat-btn{display:flex;align-items:center;gap:6px;padding:8px 18px;border:1px solid var(--border);border-radius:20px;background:transparent;color:var(--text2);font-size:13px;font-family:'Outfit',sans-serif;cursor:pointer;transition:all .2s;white-space:nowrap;flex-shrink:0}
.cat-btn:hover{border-color:var(--border-h);color:var(--text)}
.cat-btn.active{background:var(--accent);border-color:var(--accent);color:#fff;box-shadow:0 0 20px rgba(124,92,252,.35)}
.sort-select{margin-left:auto;padding:8px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:9px;color:var(--text2);font-size:13px;font-family:'Outfit',sans-serif;outline:none;cursor:pointer;flex-shrink:0}
.sort-select option{background:#1e1e26}

/* ===== GRID ===== */
.main-layout{display:flex;min-height:calc(100vh-130px);position:relative;z-index:1}
.grid{flex:1;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:18px;padding:24px 28px;align-content:start}

/* ===== CARD ===== */
.card{background:var(--surface);border:1px solid var(--border);border-radius:18px;overflow:hidden;transition:transform .3s cubic-bezier(.16,1,.3,1),box-shadow .3s,border-color .3s;animation:fadeUp .4s cubic-bezier(.16,1,.3,1) both;cursor:pointer;position:relative;display:flex;flex-direction:column}
.card:hover{transform:translateY(-8px);box-shadow:0 24px 60px rgba(0,0,0,.5),0 0 0 1px rgba(124,92,252,.25);border-color:rgba(124,92,252,.3)}
.card-img-wrap{position:relative;overflow:hidden;background:var(--surface2)}
.card-img-wrap::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(6,6,8,.6) 100%);opacity:0;transition:opacity .3s}
.card:hover .card-img-wrap::after{opacity:1}
.card img{width:100%;height:190px;object-fit:cover;display:block;transition:transform .5s cubic-bezier(.16,1,.3,1);background:var(--surface2)}
.card:hover img{transform:scale(1.08)}
.card-overlay{position:absolute;inset:0;display:flex;align-items:flex-end;padding:14px;z-index:2;opacity:0;transition:opacity .3s}
.card:hover .card-overlay{opacity:1}
.quick-add{width:100%;padding:10px;background:rgba(124,92,252,.95);backdrop-filter:blur(4px);border:none;border-radius:9px;color:#fff;font-size:12px;font-weight:700;font-family:'Outfit',sans-serif;cursor:pointer;transition:background .2s;letter-spacing:.5px}
.quick-add:hover{background:var(--accent)}
.card-badges{position:absolute;top:12px;left:12px;display:flex;gap:5px;flex-wrap:wrap;z-index:3}
.badge{padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;letter-spacing:.5px;text-transform:uppercase}
.badge-new{background:var(--accent);color:#fff}
.badge-hot{background:#ff5555;color:#fff}
.badge-sale{background:#f0a500;color:#000}
.badge-top{background:var(--accent2);color:#000}
.wishlist-btn{position:absolute;top:12px;right:12px;width:34px;height:34px;background:rgba(6,6,8,.75);border:1px solid rgba(255,255,255,.1);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;transition:all .25s;opacity:0;z-index:3}
.card:hover .wishlist-btn{opacity:1}
.wishlist-btn:hover{background:var(--accent3);border-color:var(--accent3)}
.wishlist-btn.active{opacity:1;background:var(--accent3);border-color:var(--accent3)}
.card-body{padding:16px;display:flex;flex-direction:column;flex:1}
.card-cat{font-size:10px;font-weight:700;color:var(--accent);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:5px}
.card h4{font-size:15px;font-weight:600;margin-bottom:6px;line-height:1.3;color:var(--text)}
.card-rating{display:flex;align-items:center;gap:5px;margin-bottom:10px}
.stars{color:#f0a500;font-size:12px;letter-spacing:1px}
.live-viewers{font-size:10px;color:var(--accent2);margin-left:auto;opacity:.8;font-weight:600}
.rating-count{font-size:11px;color:var(--text3)}
.card-footer{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:12px;border-top:1px solid var(--border)}
.price{font-size:20px;font-weight:700;color:var(--text);font-family:'Rajdhani','JetBrains Mono',monospace}
.price-old{font-size:12px;color:var(--text3);text-decoration:line-through;margin-left:5px;font-family:'Rajdhani','JetBrains Mono',monospace}
.add-btn{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#7c5cfc,#5a3de0);border:none;color:#fff;font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .25s;box-shadow:0 4px 14px rgba(124,92,252,.5);flex-shrink:0}
.add-btn:hover{transform:scale(1.2) rotate(90deg);box-shadow:0 6px 24px rgba(124,92,252,.7)}

/* ===== IMG PLACEHOLDER ===== */
.img-placeholder{width:100%;height:190px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--surface2),var(--surface3));gap:8px}
.img-placeholder .ph-icon{font-size:48px;opacity:.5}
.img-placeholder .ph-name{font-size:11px;color:var(--text3);text-align:center;padding:0 12px}

/* ===== EMPTY STATE ===== */
.empty-state{grid-column:1/-1;text-align:center;padding:80px 20px;color:var(--text2)}
.empty-state div{font-size:56px;margin-bottom:16px}
.empty-state p{font-size:15px}

/* ===== OVERLAY ===== */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:199;opacity:0;pointer-events:none;transition:opacity .3s;backdrop-filter:blur(2px)}
.overlay.active{opacity:1;pointer-events:all}

/* ===== PANELS (wish + cart) ===== */
.side-panel{position:fixed;top:0;bottom:0;width:380px;background:var(--surface);z-index:200;display:flex;flex-direction:column;transition:transform .4s cubic-bezier(.16,1,.3,1)}
.side-panel.left{left:0;border-right:1px solid rgba(124,92,252,.15);transform:translateX(-100%)}
.side-panel.right{right:0;border-left:1px solid rgba(124,92,252,.15);transform:translateX(100%)}
.side-panel.active{transform:translateX(0)}
.panel-head{display:flex;align-items:center;justify-content:space-between;padding:22px 22px 18px;border-bottom:1px solid var(--border)}
.panel-head h3{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:14px;color:var(--text);letter-spacing:2px}
.close-btn{width:32px;height:32px;background:var(--surface2);border:1px solid var(--border);border-radius:50%;color:var(--text2);cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;transition:all .2s}
.close-btn:hover{background:var(--accent3);border-color:var(--accent3);color:#fff}

/* ===== WISHLIST PANEL ===== */
.wish-body{flex:1;overflow-y:auto;padding:16px}
.wish-item{display:flex;gap:12px;align-items:center;padding:12px;background:var(--surface2);border:1px solid var(--border);border-radius:12px;margin-bottom:10px;animation:fadeUp .3s ease}
.wish-item-img{width:60px;height:60px;border-radius:8px;object-fit:cover;flex-shrink:0;background:var(--surface3)}
.wish-item-info{flex:1;min-width:0}
.wish-item-name{font-size:13px;font-weight:600;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wish-item-cat{font-size:11px;color:var(--accent);font-weight:600;letter-spacing:.5px;margin-bottom:4px}
.wish-item-price{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:14px;font-weight:700;color:var(--text)}
.wish-item-actions{display:flex;flex-direction:column;gap:6px;flex-shrink:0}
.wish-add-btn{padding:6px 12px;background:var(--accent);border:none;border-radius:7px;color:#fff;font-size:11px;font-weight:700;font-family:'Outfit',sans-serif;cursor:pointer;transition:all .2s;white-space:nowrap;letter-spacing:.3px}
.wish-add-btn:hover{background:#6a4ce8;transform:scale(1.04)}
.wish-remove-btn{background:none;border:none;color:var(--text3);cursor:pointer;font-size:14px;transition:color .2s;text-align:right}
.wish-remove-btn:hover{color:var(--accent3)}
.panel-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;height:240px;color:var(--text3)}
.panel-empty div{font-size:48px;margin-bottom:14px;opacity:.6}
.panel-empty p{font-size:13px}

/* ===== CART PANEL ===== */
.cart-body{flex:1;overflow-y:auto;padding:16px}
.cart-item{display:flex;gap:12px;align-items:center;padding:12px;background:var(--surface2);border:1px solid var(--border);border-radius:12px;margin-bottom:10px;animation:fadeUp .3s ease}
.cart-item-img{width:54px;height:54px;border-radius:8px;object-fit:cover;flex-shrink:0;background:var(--surface3)}
.cart-item-info{flex:1;min-width:0}
.cart-item-name{font-size:13px;font-weight:600;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cart-item-cat{font-size:11px;color:var(--accent);font-weight:600;letter-spacing:.5px}
.cart-item-right{display:flex;flex-direction:column;align-items:flex-end;gap:6px}
.cart-item-price{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:14px;font-weight:700;color:var(--text)}
.qty-wrap{display:flex;align-items:center;gap:5px}
.qty-btn{width:24px;height:24px;background:var(--surface3);border:1px solid var(--border);border-radius:5px;color:var(--text);cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;transition:all .15s}
.qty-btn:hover{background:var(--accent);border-color:var(--accent)}
.qty-num{font-size:13px;font-weight:700;min-width:20px;text-align:center}
.remove-item{background:none;border:none;color:var(--text3);cursor:pointer;font-size:14px;transition:color .2s;padding:2px}
.remove-item:hover{color:var(--accent3)}
.cart-foot{padding:18px 22px;border-top:1px solid var(--border);background:var(--surface)}
.cart-summary{margin-bottom:16px}
.cart-row{display:flex;justify-content:space-between;font-size:13px;color:var(--text2);margin-bottom:7px}
.cart-row.total{font-size:17px;font-weight:700;color:var(--text);padding-top:10px;border-top:1px solid var(--border);margin-top:10px}
.cart-row.total span:last-child{font-family:'Rajdhani','JetBrains Mono',monospace;color:var(--accent2)}
.checkout-btn{width:100%;padding:15px;background:linear-gradient(135deg,#7c5cfc,#5a3de0);border:none;border-radius:12px;color:#fff;font-size:15px;font-weight:700;font-family:'Outfit',sans-serif;cursor:pointer;letter-spacing:.5px;transition:all .2s;box-shadow:0 4px 20px rgba(124,92,252,.4)}
.checkout-btn:hover{box-shadow:0 8px 30px rgba(124,92,252,.6);transform:translateY(-1px)}
.checkout-btn:disabled{opacity:.35;cursor:not-allowed;transform:none;box-shadow:none}
.secure-note{display:flex;align-items:center;justify-content:center;gap:6px;margin-top:10px;font-size:11px;color:var(--text3)}

/* ===== CHECKOUT MODAL ===== */
.checkout-wrap{position:fixed;inset:0;z-index:400;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;pointer-events:none;transition:opacity .3s}
.checkout-wrap.active{opacity:1;pointer-events:all}
.checkout-bg{position:absolute;inset:0;background:rgba(0,0,0,.8);backdrop-filter:blur(6px)}
.checkout-modal{position:relative;width:100%;max-width:560px;background:var(--surface);border:1px solid rgba(124,92,252,.3);border-radius:24px;transform:scale(.92) translateY(24px);transition:transform .4s cubic-bezier(.16,1,.3,1);max-height:94vh;overflow-y:auto}
.checkout-wrap.active .checkout-modal{transform:scale(1) translateY(0)}
.checkout-head{display:flex;align-items:center;justify-content:space-between;padding:26px 30px 18px;border-bottom:1px solid var(--border)}
.checkout-head h2{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:16px;letter-spacing:2px}
.checkout-body{padding:26px 30px}
.checkout-step{display:none}
.checkout-step.active{display:block;animation:fadeUp .3s ease}

/* Progress */
.c-progress{display:flex;align-items:center;margin-bottom:28px}
.c-pdot{width:30px;height:30px;border-radius:50%;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--text3);transition:all .3s;flex-shrink:0;position:relative}
.c-pdot.active{border-color:var(--accent);color:var(--accent);box-shadow:0 0 0 4px rgba(124,92,252,.15)}
.c-pdot.done{border-color:var(--accent);background:var(--accent);color:#fff}
.c-pline{flex:1;height:2px;background:var(--border);margin:0 6px;transition:background .3s}
.c-pline.done{background:var(--accent)}
.c-plabel{position:absolute;top:36px;left:50%;transform:translateX(-50%);font-size:10px;color:var(--text3);white-space:nowrap;letter-spacing:.5px;display:none}

/* Order summary */
.o-summary{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:18px;margin-bottom:22px}
.o-summary-title{font-size:11px;font-weight:700;color:var(--text3);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:14px}
.o-items{max-height:180px;overflow-y:auto}
.o-item{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--border)}
.o-item:last-child{border-bottom:none}
.o-item-img{width:40px;height:40px;border-radius:7px;object-fit:cover;background:var(--surface3);flex-shrink:0}
.o-item-name{flex:1;font-size:12px;font-weight:500;line-height:1.4}
.o-item-qty{font-size:11px;color:var(--text3)}
.o-item-price{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:12px;font-weight:700;color:var(--accent2);flex-shrink:0}
.o-total-row{display:flex;justify-content:space-between;align-items:center;padding-top:12px;border-top:1px solid var(--border);margin-top:4px}
.o-total-label{font-size:13px;color:var(--text2)}
.o-total-price{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:20px;font-weight:700;color:var(--text)}

/* Delivery */
.d-section{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:18px;margin-bottom:22px}
.d-title{font-size:11px;font-weight:700;color:var(--text3);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:14px}
.f-field{margin-bottom:14px}
.f-field label{display:block;font-size:11px;font-weight:600;color:var(--text2);letter-spacing:1px;text-transform:uppercase;margin-bottom:6px}
.f-field input,.f-field select{width:100%;padding:11px 14px;background:var(--surface3);border:1px solid var(--border);border-radius:9px;color:var(--text);font-size:14px;font-family:'Outfit',sans-serif;outline:none;transition:border .2s}
.f-field input:focus,.f-field select:focus{border-color:rgba(124,92,252,.5)}
.f-field input::placeholder{color:var(--text3)}
.f-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}

/* Pay methods */
.pm-title{font-size:11px;font-weight:700;color:var(--text3);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:14px}
.pm-grid{display:flex;flex-direction:column;gap:10px;margin-bottom:22px}
.pm{display:flex;align-items:center;gap:14px;padding:14px 16px;background:var(--surface2);border:2px solid var(--border);border-radius:14px;cursor:pointer;transition:all .2s}
.pm:hover{border-color:var(--border-h)}
.pm.sel{border-color:var(--accent);background:rgba(124,92,252,.07)}
.pm-radio{width:20px;height:20px;border-radius:50%;border:2px solid var(--text3);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .2s}
.pm.sel .pm-radio{border-color:var(--accent)}
.pm-dot{width:9px;height:9px;border-radius:50%;background:var(--accent);transform:scale(0);transition:transform .2s}
.pm.sel .pm-dot{transform:scale(1)}
.pm-icon{font-size:26px;flex-shrink:0;line-height:1}
.pm-info{flex:1}
.pm-name{font-size:14px;font-weight:600;color:var(--text);margin-bottom:2px}
.pm-desc{font-size:11px;color:var(--text3)}
.pm-badge{font-size:10px;font-weight:700;padding:3px 9px;border-radius:10px;flex-shrink:0;letter-spacing:.5px}
.pm-badge.instant{background:rgba(0,229,195,.15);color:var(--accent2)}
.pm-badge.np{background:rgba(240,165,0,.15);color:var(--gold)}
.pm-badge.web3{background:rgba(124,92,252,.2);color:var(--accent)}

/* Card form */
.card-form{background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:22px;display:none}
.card-form.show{display:block;animation:fadeUp .25s ease}
.card-visual{height:56px;background:linear-gradient(135deg,#1a1a2e,#16213e,#0f3460);border-radius:10px;margin-bottom:14px;display:flex;align-items:center;padding:0 16px;gap:10px;position:relative;overflow:hidden}
.card-visual::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(45deg,transparent,transparent 10px,rgba(255,255,255,.015) 10px,rgba(255,255,255,.015) 20px)}
.card-chip{width:32px;height:24px;background:linear-gradient(135deg,#d4a843,#c89a30);border-radius:4px;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:2px;padding:3px}
.card-chip div{background:rgba(0,0,0,.3);border-radius:1px}
.card-network{margin-left:auto;font-size:20px}
.card-num-display{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:13px;color:rgba(255,255,255,.7);letter-spacing:2px}

/* Pay btn */
.pay-btn{width:100%;padding:16px;background:linear-gradient(135deg,#00c97a,#00a562);border:none;border-radius:12px;color:#fff;font-size:15px;font-weight:700;font-family:'Outfit',sans-serif;cursor:pointer;letter-spacing:.5px;transition:all .2s;box-shadow:0 4px 20px rgba(0,201,122,.3);display:flex;align-items:center;justify-content:center;gap:10px}
.pay-btn:hover{box-shadow:0 8px 30px rgba(0,201,122,.5);transform:translateY(-1px)}
.pay-btn:disabled{opacity:.4;cursor:not-allowed;transform:none}
.back-btn{width:100%;padding:11px;background:var(--surface2);border:1px solid var(--border);border-radius:10px;color:var(--text2);font-size:13px;font-weight:500;font-family:'Outfit',sans-serif;cursor:pointer;transition:all .2s;margin-top:10px}
.back-btn:hover{border-color:var(--border-h);color:var(--text)}

/* Success */
.pay-success{text-align:center;padding:10px 0 6px}
.success-icon{width:80px;height:80px;border-radius:50%;background:radial-gradient(circle,rgba(34,197,94,.25),rgba(0,229,195,.1));border:2px solid rgba(34,197,94,.5);margin:0 auto 20px;display:flex;align-items:center;justify-content:center;font-size:36px;animation:successPop .6s cubic-bezier(.16,1,.3,1)}
.pay-success h3{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:20px;color:var(--text);margin-bottom:10px}
.pay-success p{font-size:14px;color:var(--text2);line-height:1.7;margin-bottom:20px}
.order-num{padding:12px 22px;background:var(--surface2);border:1px dashed rgba(124,92,252,.35);border-radius:10px;font-family:'Rajdhani','JetBrains Mono',monospace;font-size:14px;color:var(--accent);letter-spacing:3px;margin-bottom:20px;display:inline-block}
.finish-btn{padding:14px 36px;background:linear-gradient(135deg,#7c5cfc,#5a3de0);border:none;border-radius:12px;color:#fff;font-size:14px;font-weight:700;font-family:'Outfit',sans-serif;cursor:pointer;transition:all .2s;box-shadow:0 4px 20px rgba(124,92,252,.4)}
.finish-btn:hover{box-shadow:0 8px 30px rgba(124,92,252,.6);transform:translateY(-1px)}

/* Promo input in checkout */
.promo-input-row{display:flex;gap:8px;margin-bottom:14px}
.promo-input-row input{flex:1;padding:10px 14px;background:var(--surface3);border:1px solid var(--border);border-radius:9px;color:var(--text);font-size:13px;font-family:'Outfit',sans-serif;outline:none;transition:border .2s}
.promo-input-row input:focus{border-color:rgba(124,92,252,.4)}
.promo-apply-btn{padding:10px 16px;background:rgba(124,92,252,.15);border:1px solid rgba(124,92,252,.3);border-radius:9px;color:var(--accent);font-size:13px;font-weight:600;font-family:'Outfit',sans-serif;cursor:pointer;white-space:nowrap;transition:all .2s}
.promo-apply-btn:hover{background:rgba(124,92,252,.25)}
.promo-status{font-size:12px;margin-bottom:14px;min-height:16px}
.promo-status.ok{color:var(--accent2)}
.promo-status.err{color:var(--accent3)}

/* ===== PRODUCT MODAL ===== */
.modal-wrap{position:fixed;inset:0;z-index:300;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;pointer-events:none;transition:opacity .3s}
.modal-bg{position:absolute;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(4px)}
.modal-wrap.active{opacity:1;pointer-events:all}
.modal{position:relative;width:100%;max-width:660px;background:var(--surface);border:1px solid rgba(124,92,252,.2);border-radius:22px;overflow:hidden;transform:scale(.92) translateY(20px);transition:transform .4s cubic-bezier(.16,1,.3,1);max-height:92vh;overflow-y:auto}
.modal-wrap.active .modal{transform:scale(1) translateY(0)}
.modal-img-wrap{position:relative;background:var(--surface2);height:280px;display:flex;align-items:center;justify-content:center;overflow:hidden}
.modal-img{width:100%;height:100%;object-fit:cover}
.modal-close{position:absolute;top:14px;right:14px;width:36px;height:36px;background:rgba(6,6,8,.8);border:1px solid rgba(255,255,255,.1);border-radius:50%;color:var(--text2);cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;transition:all .2s;z-index:10}
.modal-close:hover{background:var(--accent3);border-color:var(--accent3);color:#fff}
.modal-body{padding:26px}
.modal-cat{font-size:11px;font-weight:700;color:var(--accent);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:6px}
.modal-name{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:24px;font-weight:700;margin-bottom:10px;line-height:1.2}
.modal-rating{display:flex;align-items:center;gap:8px;margin-bottom:14px}
.modal-desc{font-size:14px;color:var(--text2);line-height:1.8;margin-bottom:22px}
.modal-specs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:24px}
.spec-item{padding:12px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:10px}
.spec-label{font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:.8px;margin-bottom:4px}
.spec-val{font-size:13px;font-weight:600;color:var(--text)}
.modal-footer{display:flex;align-items:center;gap:14px}
.modal-price{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:30px;font-weight:700;color:var(--text)}
.modal-wish-btn{width:48px;height:48px;border-radius:50%;background:var(--surface2);border:1px solid var(--border);color:var(--text2);font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0}
.modal-wish-btn:hover,.modal-wish-btn.active{background:var(--accent3);border-color:var(--accent3);color:#fff}
.modal-add-btn{flex:1;padding:15px;background:linear-gradient(135deg,#7c5cfc,#5a3de0);border:none;border-radius:14px;color:#fff;font-size:15px;font-weight:700;font-family:'Outfit',sans-serif;cursor:pointer;transition:all .2s;box-shadow:0 4px 20px rgba(124,92,252,.4)}
.modal-add-btn:hover{box-shadow:0 8px 30px rgba(124,92,252,.6);transform:translateY(-1px)}

/* ===== TOAST ===== */
.toasts{position:fixed;bottom:28px;left:50%;transform:translateX(-50%);z-index:999;display:flex;flex-direction:column;gap:8px;pointer-events:none;align-items:center}
.toast{background:rgba(14,14,18,.95);border:1px solid rgba(124,92,252,.3);color:var(--text);padding:12px 22px;border-radius:12px;font-size:13px;font-weight:500;white-space:nowrap;box-shadow:0 8px 32px rgba(0,0,0,.4);animation:toastIn .35s cubic-bezier(.16,1,.3,1) forwards;backdrop-filter:blur(10px)}
.toast.success{border-color:rgba(0,229,195,.4);color:var(--accent2)}
.toast.error{border-color:rgba(255,85,85,.4);color:var(--accent3)}
.toast.out{animation:toastOut .3s ease forwards}

/* ===== USER MENU ===== */
.user-btn{display:flex;align-items:center;gap:8px;padding:7px 13px;background:var(--surface2);border:1px solid var(--border);border-radius:9px;color:var(--text2);font-size:13px;cursor:pointer;transition:all .2s;position:relative}
.user-btn:hover{border-color:var(--border-h);color:var(--text)}
.user-avatar{width:26px;height:26px;background:linear-gradient(135deg,var(--accent),#5a3de0);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;flex-shrink:0}
.dropdown{position:absolute;top:calc(100% + 8px);right:0;background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:6px;min-width:180px;box-shadow:0 12px 40px rgba(0,0,0,.5);opacity:0;pointer-events:none;transform:translateY(-8px);transition:all .2s;z-index:200}
.user-btn:focus-within .dropdown,.user-btn:hover .dropdown{opacity:1;pointer-events:all;transform:translateY(0)}
.dropdown-item{display:block;width:100%;padding:10px 13px;background:none;border:none;color:var(--text2);font-size:13px;font-family:'Outfit',sans-serif;cursor:pointer;border-radius:7px;text-align:left;transition:all .15s}
.dropdown-item:hover{background:var(--surface3);color:var(--text)}
.dropdown-item.danger:hover{color:var(--accent3)}

/* ===== STATS BAR ===== */
.stats-bar{display:flex;border-bottom:1px solid var(--border)}
.stat-item{flex:1;padding:14px 22px;border-right:1px solid var(--border);display:flex;align-items:center;gap:12px}
.stat-item:last-child{border-right:none}
.stat-icon{font-size:22px}
.stat-info span:first-child{display:block;font-size:10px;color:var(--text3);text-transform:uppercase;letter-spacing:1px;margin-bottom:3px}
.stat-info strong{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:14px;color:var(--text)}

/* ===== PROMO ===== */
.promo-banner{margin:22px 28px 0;padding:22px 26px;background:linear-gradient(135deg,rgba(124,92,252,.12) 0%,rgba(0,229,195,.07) 100%);border:1px solid rgba(124,92,252,.2);border-radius:16px;display:flex;align-items:center;justify-content:space-between;gap:20px;position:relative;overflow:hidden}
.promo-banner::before{content:'';position:absolute;right:-60px;top:-40px;width:220px;height:220px;background:radial-gradient(circle,rgba(124,92,252,.12) 0%,transparent 60%)}
.promo-banner::after{content:'';position:absolute;left:-40px;bottom:-50px;width:180px;height:180px;background:radial-gradient(circle,rgba(0,229,195,.08) 0%,transparent 60%)}
.promo-text h3{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:17px;margin-bottom:4px}
.promo-text p{font-size:13px;color:var(--text2)}
.promo-right{display:flex;align-items:center;gap:12px;flex-shrink:0;position:relative;z-index:1}
.promo-code{background:rgba(124,92,252,.15);border:1px dashed rgba(124,92,252,.5);border-radius:10px;padding:10px 20px;font-family:'Rajdhani','JetBrains Mono',monospace;font-size:18px;color:var(--accent);cursor:pointer;transition:all .2s;position:relative}
.promo-code:hover{background:rgba(124,92,252,.28);transform:scale(1.03)}
.promo-countdown{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:12px;color:var(--text3);text-align:center}
.promo-countdown span{display:block;font-size:18px;color:var(--accent3);font-weight:700}

/* ===== SCROLL TOP ===== */
.scroll-top{position:fixed;bottom:90px;right:24px;width:40px;height:40px;background:var(--accent);border:none;border-radius:50%;color:#fff;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(124,92,252,.5);transition:all .3s;opacity:0;pointer-events:none;z-index:150}
.scroll-top.show{opacity:1;pointer-events:all}
.scroll-top:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(124,92,252,.7)}

/* ===== ANIMATIONS ===== */
@keyframes slideUp{from{opacity:0;transform:translateY(32px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.75)}}
@keyframes bump{0%{transform:scale(1)}35%{transform:scale(1.45)}70%{transform:scale(.85)}100%{transform:scale(1)}}
@keyframes toastIn{from{opacity:0;transform:translateY(18px) scale(.88)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes toastOut{from{opacity:1;transform:translateY(0) scale(1)}to{opacity:0;transform:translateY(-12px) scale(.9)}}
@keyframes shimmer{from{background-position:-200% 0}to{background-position:200% 0}}
@keyframes successPop{from{transform:scale(0) rotate(-10deg);opacity:0}to{transform:scale(1) rotate(0);opacity:1}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
@keyframes glow-pulse{0%,100%{box-shadow:0 0 20px rgba(124,92,252,.3)}50%{box-shadow:0 0 40px rgba(124,92,252,.6)}}

.skeleton{background:linear-gradient(90deg,var(--surface2) 25%,var(--surface3) 50%,var(--surface2) 75%);background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:8px}
.hidden{display:none!important}
select option{background:#1e1e26;color:#f0f0f8}

/* Spinner */
.spinner{width:22px;height:22px;border:2px solid rgba(255,255,255,.25);border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite}

/* Light mode */
body.light{--bg:#f0f0f6;--surface:#fff;--surface2:#e8e8f0;--surface3:#d8d8e8;--border:rgba(0,0,0,.08);--border-h:rgba(0,0,0,.16);--text:#0f0f18;--text2:#444455;--text3:#888899}

/* ===== PROFILE PANEL ===== */
.profile-wrap{position:fixed;inset:0;z-index:350;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;pointer-events:none;transition:opacity .3s}
.profile-wrap.active{opacity:1;pointer-events:all}
.profile-bg{position:absolute;inset:0;background:rgba(0,0,0,.82);backdrop-filter:blur(8px)}
.profile-modal{position:relative;width:100%;max-width:680px;background:var(--surface);border:1px solid rgba(124,92,252,.22);border-radius:24px;overflow:hidden;transform:scale(.93) translateY(24px);transition:transform .4s cubic-bezier(.16,1,.3,1);max-height:94vh;overflow-y:auto;display:flex;flex-direction:column}
.profile-wrap.active .profile-modal{transform:scale(1) translateY(0)}
.profile-close{position:absolute;top:16px;right:16px;width:34px;height:34px;background:var(--surface2);border:1px solid var(--border);border-radius:50%;color:var(--text2);cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;transition:all .2s;z-index:5}
.profile-close:hover{background:var(--accent3);border-color:var(--accent3);color:#fff}

/* Header zone */
.profile-hero{background:linear-gradient(135deg,#0a0416 0%,#140830 40%,#0a1830 100%);padding:36px 30px 28px;position:relative;overflow:hidden}
.profile-hero::before{content:'';position:absolute;top:-40px;left:-40px;width:200px;height:200px;background:radial-gradient(circle,rgba(124,92,252,.25),transparent 70%);pointer-events:none}
.profile-hero::after{content:'';position:absolute;bottom:-40px;right:-40px;width:180px;height:180px;background:radial-gradient(circle,rgba(0,229,195,.15),transparent 70%);pointer-events:none}
.profile-hero-inner{position:relative;z-index:2;display:flex;align-items:center;gap:22px}
.avatar-wrap{position:relative;flex-shrink:0}
.avatar-img{width:82px;height:82px;border-radius:50%;object-fit:cover;border:3px solid rgba(124,92,252,.5);box-shadow:0 0 0 4px rgba(124,92,252,.15);display:block;background:var(--surface2)}
.avatar-placeholder{width:82px;height:82px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#5a3de0);border:3px solid rgba(124,92,252,.5);display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;color:#fff}
.avatar-upload-btn{position:absolute;bottom:0;right:0;width:26px;height:26px;background:var(--accent2);border:2px solid var(--surface);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:12px;transition:transform .2s}
.avatar-upload-btn:hover{transform:scale(1.15)}
.profile-info{flex:1;min-width:0}
.profile-name{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:22px;font-weight:700;color:#fff;margin-bottom:4px}
.profile-email{font-size:12px;color:rgba(255,255,255,.45);margin-bottom:10px}
.profile-badges{display:flex;gap:7px;flex-wrap:wrap}
.profile-badge{padding:3px 11px;border-radius:20px;font-size:10px;font-weight:700;letter-spacing:.5px}
.profile-badge.vip{background:rgba(240,165,0,.2);color:var(--gold);border:1px solid rgba(240,165,0,.3)}
.profile-badge.verified{background:rgba(0,229,195,.15);color:var(--accent2);border:1px solid rgba(0,229,195,.3)}
.profile-badge.member{background:rgba(124,92,252,.15);color:var(--accent);border:1px solid rgba(124,92,252,.3)}

/* Profile tabs */
.profile-tabs{display:flex;gap:0;border-bottom:1px solid var(--border);background:var(--surface)}
.profile-tab{flex:1;padding:14px 8px;background:none;border:none;border-bottom:2px solid transparent;color:var(--text3);font-size:12px;font-weight:700;font-family:'Outfit',sans-serif;cursor:pointer;transition:all .2s;letter-spacing:.5px;text-transform:uppercase}
.profile-tab.active{color:var(--accent);border-bottom-color:var(--accent)}
.profile-tab:hover{color:var(--text)}

/* Profile body */
.profile-body{padding:24px 28px}
.profile-section{display:none}
.profile-section.active{display:block;animation:fadeUp .25s ease}

/* Stats grid */
.p-stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:24px}
.p-stat{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:14px;text-align:center}
.p-stat-val{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:22px;font-weight:700;color:var(--text);margin-bottom:3px}
.p-stat-val.green{color:var(--accent2)}
.p-stat-val.purple{color:var(--accent)}
.p-stat-val.gold{color:var(--gold)}
.p-stat-label{font-size:10px;color:var(--text3);letter-spacing:.5px;text-transform:uppercase}

/* Edit form */
.p-form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.p-field{margin-bottom:0}
.p-field label{display:block;font-size:10px;font-weight:700;color:var(--text3);letter-spacing:1px;text-transform:uppercase;margin-bottom:5px}
.p-field input,.p-field select{width:100%;padding:10px 13px;background:var(--surface2);border:1px solid var(--border);border-radius:9px;color:var(--text);font-size:13px;font-family:'Outfit',sans-serif;outline:none;transition:border .2s}
.p-field input:focus{border-color:rgba(124,92,252,.5);box-shadow:0 0 0 3px rgba(124,92,252,.08)}
.p-field input::placeholder{color:var(--text3)}
.p-save-btn{padding:11px 24px;background:linear-gradient(135deg,#7c5cfc,#5a3de0);border:none;border-radius:10px;color:#fff;font-size:13px;font-weight:700;font-family:'Outfit',sans-serif;cursor:pointer;transition:all .2s;box-shadow:0 4px 16px rgba(124,92,252,.3)}
.p-save-btn:hover{transform:translateY(-1px);box-shadow:0 6px 24px rgba(124,92,252,.5)}

/* Orders */
.orders-empty{text-align:center;padding:48px 20px;color:var(--text3)}
.orders-empty div{font-size:48px;margin-bottom:14px;opacity:.5}
.order-card{background:var(--surface2);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:12px;transition:border-color .2s}
.order-card:hover{border-color:rgba(124,92,252,.25)}
.order-head{display:flex;align-items:center;gap:12px;padding:13px 16px;border-bottom:1px solid var(--border);cursor:pointer}
.order-num{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:13px;font-weight:700;color:var(--accent);letter-spacing:1px}
.order-date{font-size:11px;color:var(--text3);margin-left:auto}
.order-total{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:14px;font-weight:700;color:var(--accent2);flex-shrink:0}
.order-status{padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;letter-spacing:.5px;flex-shrink:0}
.order-status.delivered{background:rgba(0,229,195,.12);color:var(--accent2)}
.order-status.processing{background:rgba(124,92,252,.12);color:var(--accent)}
.order-status.cancelled{background:rgba(255,85,85,.12);color:var(--accent3)}
.order-body{padding:12px 16px;display:none}
.order-body.open{display:block;animation:fadeUp .2s ease}
.order-item-row{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--border)}
.order-item-row:last-child{border-bottom:none}
.order-item-img{width:38px;height:38px;border-radius:7px;object-fit:contain;background:var(--surface3);padding:4px;flex-shrink:0}
.order-item-name{flex:1;font-size:12px;font-weight:500}
.order-item-price{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:12px;font-weight:700;color:var(--text2);flex-shrink:0}
.order-arrow{font-size:12px;color:var(--text3);transition:transform .2s;flex-shrink:0;margin-left:4px}
.order-head.open .order-arrow{transform:rotate(180deg)}

/* Wishlist in profile */
.p-wish-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.p-wish-card{background:var(--surface2);border:1px solid var(--border);border-radius:12px;overflow:hidden;cursor:pointer;transition:all .2s}
.p-wish-card:hover{border-color:rgba(124,92,252,.35);transform:translateY(-3px)}
.p-wish-img{width:100%;height:80px;object-fit:contain;padding:8px;background:var(--surface3)}
.p-wish-name{font-size:11px;font-weight:600;padding:7px 8px 2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.p-wish-price{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:13px;font-weight:700;color:var(--accent2);padding:0 8px 8px}

/* Security section */
.security-item{display:flex;align-items:center;gap:14px;padding:14px;background:var(--surface2);border:1px solid var(--border);border-radius:12px;margin-bottom:10px}
.security-icon{font-size:22px;flex-shrink:0}
.security-info{flex:1}
.security-title{font-size:13px;font-weight:600;color:var(--text);margin-bottom:2px}
.security-desc{font-size:11px;color:var(--text3)}
.security-action{padding:7px 14px;background:transparent;border:1px solid var(--border);border-radius:8px;color:var(--text2);font-size:11px;font-weight:600;font-family:'Outfit',sans-serif;cursor:pointer;transition:all .2s;white-space:nowrap;flex-shrink:0}
.security-action:hover{border-color:var(--accent);color:var(--accent)}
.danger-zone{margin-top:20px;padding:16px;border:1px solid rgba(255,85,85,.2);border-radius:12px;background:rgba(255,85,85,.04)}
.danger-title{font-size:11px;font-weight:700;color:var(--accent3);letter-spacing:1px;text-transform:uppercase;margin-bottom:10px}

/* Responsive */
@media(max-width:768px){
  header{padding:0 16px;height:56px}
  .header-center{max-width:200px;margin:0 10px}
  .grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;padding:14px 16px}
  .side-panel{width:100%}
  .stats-bar{display:none}
  .promo-banner{flex-direction:column;margin:14px 16px 0}
  .filter-bar{padding:10px 16px}
  .hero-banner{flex-direction:column;min-height:320px;padding:32px 20px}
  .hero-visual{display:none}
  .hero-title{font-size:28px}
}

/* ===== HERO BANNER ===== */
.hero-banner{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:space-between;min-height:360px;padding:40px 60px;background:linear-gradient(135deg,#0a0a18 0%,#12082e 50%,#0a1a10 100%);border-bottom:1px solid rgba(124,92,252,.2)}
.hero-canvas{position:absolute;inset:0;pointer-events:none}
.hero-content{position:relative;z-index:2;max-width:520px}
.hero-tag{display:inline-flex;align-items:center;gap:6px;padding:5px 14px;background:rgba(124,92,252,.15);border:1px solid rgba(124,92,252,.3);border-radius:20px;font-size:11px;font-weight:700;color:var(--accent);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:18px}
.hero-title{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:38px;font-weight:700;line-height:1.15;margin-bottom:14px;color:#fff}
.hero-accent{background:linear-gradient(90deg,#7c5cfc,#00e5c3);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-sub{font-size:14px;color:rgba(255,255,255,.55);margin-bottom:28px;letter-spacing:.5px}
.hero-actions{display:flex;gap:12px;margin-bottom:32px;flex-wrap:wrap}
.hero-btn-primary{padding:13px 28px;background:linear-gradient(135deg,#7c5cfc,#5a3de0);border:none;border-radius:10px;color:#fff;font-size:14px;font-weight:700;font-family:'Outfit',sans-serif;cursor:pointer;box-shadow:0 6px 28px rgba(124,92,252,.45);transition:all .25s;letter-spacing:.3px}
.hero-btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 36px rgba(124,92,252,.65)}
.hero-btn-ghost{padding:13px 28px;background:transparent;border:1px solid rgba(255,255,255,.2);border-radius:10px;color:rgba(255,255,255,.8);font-size:14px;font-weight:600;font-family:'Outfit',sans-serif;cursor:pointer;transition:all .25s}
.hero-btn-ghost:hover{border-color:rgba(0,229,195,.5);color:#00e5c3}
.hero-stats{display:flex;align-items:center;gap:20px}
.hero-stat{text-align:center}
.hero-stat strong{display:block;font-family:'Rajdhani','JetBrains Mono',monospace;font-size:20px;font-weight:700;color:#fff}
.hero-stat span{font-size:11px;color:rgba(255,255,255,.45);letter-spacing:.5px}
.hero-stat-sep{width:1px;height:36px;background:rgba(255,255,255,.1)}
.hero-visual{position:relative;z-index:2}
.hero-card-float{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(20px);border-radius:20px;padding:24px;width:220px;text-align:center;animation:heroFloat 3s ease-in-out infinite;box-shadow:0 24px 80px rgba(0,0,0,.5),0 0 0 1px rgba(124,92,252,.15)}
@keyframes heroFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
.hf-badge{font-size:10px;font-weight:700;color:#ff5555;letter-spacing:1px;margin-bottom:12px}
.hf-icon{font-size:64px;margin-bottom:10px;filter:drop-shadow(0 8px 20px rgba(0,80,160,.6))}
.hf-name{font-size:15px;font-weight:700;color:#fff;margin-bottom:6px}
.hf-price{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:22px;font-weight:700;color:#00e5c3;margin-bottom:14px}
.hf-btn{width:100%;padding:10px;background:linear-gradient(135deg,#7c5cfc,#5a3de0);border:none;border-radius:8px;color:#fff;font-size:13px;font-weight:700;font-family:'Outfit',sans-serif;cursor:pointer;transition:all .2s}
.hf-btn:hover{opacity:.85}
.hero-close{position:absolute;top:16px;right:20px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:50%;width:32px;height:32px;color:rgba(255,255,255,.5);cursor:pointer;font-size:14px;z-index:3;transition:all .2s}
.hero-close:hover{background:rgba(255,85,85,.3);color:#fff;border-color:rgba(255,85,85,.4)}

/* ===== CARD IMAGE improved ===== */
.card img{width:100%;height:200px;object-fit:contain;display:block;transition:transform .5s cubic-bezier(.16,1,.3,1);padding:12px;background:transparent}

/* ===== RECENTLY VIEWED ===== */
.recently-wrap{padding:16px 28px 24px;border-top:1px solid var(--border);position:relative;z-index:1}
.recently-head{display:flex;align-items:center;justify-content:space-between;font-size:13px;font-weight:700;color:var(--text2);letter-spacing:1px;margin-bottom:12px;text-transform:uppercase}
.recently-list{display:flex;gap:12px;overflow-x:auto;padding-bottom:6px}
.recently-list::-webkit-scrollbar{height:3px}
.recently-list::-webkit-scrollbar-thumb{background:var(--accent);border-radius:3px}
.recently-item{flex-shrink:0;width:120px;background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;cursor:pointer;transition:all .2s}
.recently-item:hover{border-color:rgba(124,92,252,.35);transform:translateY(-4px)}
.recently-item img{width:100%;height:70px;object-fit:contain;background:var(--surface2);padding:6px}
.recently-item-name{font-size:11px;font-weight:600;padding:6px 8px 3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.recently-item-price{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:12px;font-weight:700;padding:0 8px 8px;color:var(--accent2)}

/* ===== COMPARE ===== */
.compare-bar{position:fixed;bottom:0;left:0;right:0;z-index:150;animation:slideUp .3s cubic-bezier(.16,1,.3,1)}
.compare-bar-inner{display:flex;align-items:center;gap:14px;padding:14px 28px;background:rgba(14,14,18,.97);border-top:1px solid rgba(124,92,252,.3);backdrop-filter:blur(20px)}
.compare-title{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:12px;color:var(--text2);letter-spacing:1px;flex-shrink:0}
.compare-items{display:flex;gap:8px;flex:1;overflow-x:auto}
.compare-chip{display:flex;align-items:center;gap:6px;padding:5px 12px;background:rgba(124,92,252,.15);border:1px solid rgba(124,92,252,.3);border-radius:20px;font-size:12px;color:var(--text);white-space:nowrap;flex-shrink:0}
.compare-chip-remove{background:none;border:none;color:var(--text3);cursor:pointer;font-size:14px;line-height:1;padding:0;transition:color .2s}
.compare-chip-remove:hover{color:var(--accent3)}
.compare-go-btn{padding:8px 20px;background:var(--accent);border:none;border-radius:8px;color:#fff;font-size:12px;font-weight:700;font-family:'Outfit',sans-serif;cursor:pointer;flex-shrink:0;transition:all .2s}
.compare-go-btn:hover{background:#6a4ce8}
.compare-clear{background:none;border:1px solid var(--border);border-radius:8px;color:var(--text3);cursor:pointer;padding:6px 12px;font-size:13px;flex-shrink:0;transition:all .2s}
.compare-clear:hover{color:var(--accent3);border-color:var(--accent3)}
.card-compare-btn{position:absolute;bottom:60px;right:12px;width:30px;height:30px;background:rgba(6,6,8,.75);border:1px solid rgba(255,255,255,.12);border-radius:6px;color:var(--text2);cursor:pointer;font-size:13px;display:flex;align-items:center;justify-content:center;opacity:0;z-index:3;transition:all .2s}
.card:hover .card-compare-btn{opacity:1}
.card-compare-btn:hover,.card-compare-btn.active{background:rgba(124,92,252,.3);border-color:var(--accent);color:var(--accent)}
/* Compare modal */
.compare-modal-wrap{position:fixed;inset:0;z-index:500;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;pointer-events:none;transition:opacity .3s}
.compare-modal-wrap.active{opacity:1;pointer-events:all}
.compare-modal-bg{position:absolute;inset:0;background:rgba(0,0,0,.8);backdrop-filter:blur(6px)}
.compare-modal{position:relative;width:100%;max-width:900px;max-height:90vh;overflow-y:auto;background:var(--surface);border:1px solid rgba(124,92,252,.25);border-radius:20px;padding:28px}
.compare-modal h2{font-family:'Rajdhani','JetBrains Mono',monospace;font-size:16px;letter-spacing:2px;margin-bottom:24px}
.compare-table{width:100%;border-collapse:collapse}
.compare-table td,.compare-table th{padding:11px 14px;border-bottom:1px solid var(--border);font-size:13px;text-align:left}
.compare-table th{font-size:11px;font-weight:700;color:var(--text3);letter-spacing:1px;text-transform:uppercase;background:var(--surface2)}
.compare-table td:first-child{color:var(--text2);font-weight:600;width:130px}
.compare-table .compare-val{font-weight:600;color:var(--text)}
.compare-table .compare-best{color:var(--accent2);font-weight:700}
.compare-close-btn{position:absolute;top:18px;right:18px;width:32px;height:32px;background:var(--surface2);border:1px solid var(--border);border-radius:50%;color:var(--text2);cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;transition:all .2s}
.compare-close-btn:hover{background:var(--accent3);border-color:var(--accent3);color:#fff}

/* ===== VIEW TOGGLE ===== */
.view-toggle{display:flex;gap:4px;padding:8px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:9px;margin-left:8px;flex-shrink:0}
.vt-btn{background:none;border:none;color:var(--text3);cursor:pointer;font-size:15px;padding:2px 6px;border-radius:5px;transition:all .15s}
.vt-btn.active{background:var(--accent);color:#fff}
.grid.list-view{grid-template-columns:1fr;gap:10px}
.grid.list-view .card{flex-direction:row;height:110px}
.grid.list-view .card-img-wrap{width:140px;flex-shrink:0;height:100%}
.grid.list-view .card img{height:100%;width:140px;object-fit:contain}
.grid.list-view .card-overlay{display:none}
.grid.list-view .card-badges{flex-direction:column}

/* ===== AI SUPPORT CHAT ===== */
#aiChatBtn{position:fixed;bottom:28px;right:28px;z-index:500;width:62px;height:62px;border-radius:50%;background:linear-gradient(135deg,#7c5cfc,#00e5c3);border:none;cursor:pointer;font-size:26px;box-shadow:0 8px 32px rgba(124,92,252,.5),0 0 0 0 rgba(124,92,252,.4);animation:chatPulse 2.5s infinite;transition:transform .25s,box-shadow .25s;display:flex;align-items:center;justify-content:center}
#aiChatBtn:hover{transform:scale(1.12);box-shadow:0 12px 40px rgba(124,92,252,.7)}
#aiChatBtn .chat-notif{position:absolute;top:2px;right:2px;width:16px;height:16px;background:#ff5555;border-radius:50%;border:2px solid var(--bg);font-size:9px;font-weight:700;color:#fff;display:flex;align-items:center;justify-content:center}
@keyframes chatPulse{0%,100%{box-shadow:0 8px 32px rgba(124,92,252,.5),0 0 0 0 rgba(124,92,252,.35)}50%{box-shadow:0 8px 32px rgba(124,92,252,.5),0 0 0 12px rgba(124,92,252,0)}}
#aiChatWrap{position:fixed;bottom:104px;right:28px;z-index:500;width:370px;max-height:580px;background:var(--surface);border:1px solid rgba(124,92,252,.3);border-radius:20px;box-shadow:0 24px 80px rgba(0,0,0,.6),0 0 0 1px rgba(124,92,252,.1);display:flex;flex-direction:column;transform:scale(.85) translateY(20px);opacity:0;pointer-events:none;transition:all .35s cubic-bezier(.16,1,.3,1);transform-origin:bottom right}
#aiChatWrap.open{transform:scale(1) translateY(0);opacity:1;pointer-events:all}
.chat-head{padding:16px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;background:linear-gradient(135deg,rgba(124,92,252,.12),rgba(0,229,195,.06));border-radius:20px 20px 0 0}
.chat-head-avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#7c5cfc,#00e5c3);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;box-shadow:0 0 14px rgba(124,92,252,.4)}
.chat-head-info{flex:1}
.chat-head-name{font-weight:700;font-size:14px;color:var(--text)}
.chat-head-status{font-size:11px;color:var(--accent2);display:flex;align-items:center;gap:4px}
.chat-head-status::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--accent2);animation:pulse 2s infinite}
.chat-close-btn{background:none;border:none;color:var(--text3);cursor:pointer;font-size:18px;padding:4px;border-radius:6px;transition:all .2s}
.chat-close-btn:hover{background:var(--surface3);color:var(--text)}
.chat-messages{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px;max-height:360px;min-height:200px}
.chat-messages::-webkit-scrollbar{width:3px}
.chat-messages::-webkit-scrollbar-thumb{background:var(--accent);border-radius:3px}
.chat-msg{max-width:82%;font-size:13px;line-height:1.5;animation:fadeUp .3s ease}
.chat-msg.bot{align-self:flex-start}
.chat-msg.user{align-self:flex-end}
.chat-msg-bubble{padding:10px 14px;border-radius:14px}
.chat-msg.bot .chat-msg-bubble{background:var(--surface2);border:1px solid var(--border);color:var(--text);border-radius:4px 14px 14px 14px}
.chat-msg.user .chat-msg-bubble{background:linear-gradient(135deg,#7c5cfc,#5a3de0);color:#fff;border-radius:14px 14px 4px 14px}
.chat-msg-time{font-size:10px;color:var(--text3);margin-top:3px;padding:0 2px}
.chat-msg.user .chat-msg-time{text-align:right}
.chat-typing{align-self:flex-start;display:flex;gap:4px;padding:10px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:4px 14px 14px 14px}
.chat-typing span{width:7px;height:7px;background:var(--accent);border-radius:50%;animation:typingDot 1.2s infinite}
.chat-typing span:nth-child(2){animation-delay:.2s}
.chat-typing span:nth-child(3){animation-delay:.4s}
@keyframes typingDot{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-6px)}}
.chat-quick-btns{display:flex;gap:6px;padding:0 14px 10px;flex-wrap:wrap}
.chat-quick-btn{padding:6px 12px;background:var(--surface2);border:1px solid var(--border);border-radius:14px;color:var(--text2);font-size:11px;font-family:'Outfit',sans-serif;cursor:pointer;transition:all .2s;white-space:nowrap}
.chat-quick-btn:hover{border-color:var(--accent);color:var(--accent);background:rgba(124,92,252,.08)}
.chat-input-row{display:flex;gap:8px;padding:12px 14px;border-top:1px solid var(--border);background:var(--surface);border-radius:0 0 20px 20px}
.chat-input{flex:1;padding:10px 13px;background:var(--surface2);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:13px;font-family:'Outfit',sans-serif;outline:none;resize:none;transition:border .2s}
.chat-input:focus{border-color:rgba(124,92,252,.4)}
.chat-send-btn{width:38px;height:38px;background:linear-gradient(135deg,#7c5cfc,#5a3de0);border:none;border-radius:9px;color:#fff;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0}
.chat-send-btn:hover{transform:scale(1.08);box-shadow:0 4px 14px rgba(124,92,252,.5)}
.chat-send-btn:disabled{opacity:.4;cursor:not-allowed;transform:none}

/* ===== LIVE DEALS TICKER ===== */
.deals-ticker{background:linear-gradient(90deg,rgba(124,92,252,.15),rgba(0,229,195,.1),rgba(124,92,252,.15));border-bottom:1px solid var(--border);padding:8px 0;overflow:hidden;position:relative}
.deals-ticker::before,.deals-ticker::after{content:'';position:absolute;top:0;bottom:0;width:80px;z-index:2}
.deals-ticker::before{left:0;background:linear-gradient(90deg,var(--bg),transparent)}
.deals-ticker::after{right:0;background:linear-gradient(-90deg,var(--bg),transparent)}
.deals-ticker-inner{display:flex;gap:0;white-space:nowrap;animation:tickerScroll 35s linear infinite}
@keyframes tickerScroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.ticker-item{display:inline-flex;align-items:center;gap:6px;padding:0 24px;font-size:12px;font-weight:600;color:var(--text2)}
.ticker-item .ticker-badge{padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;background:var(--accent);color:#fff}
.ticker-item .ticker-price{font-family:'Rajdhani','JetBrains Mono',monospace;color:var(--accent2)}
